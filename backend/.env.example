PORT=3000
JWT_SECRET=dev-secret-change-me
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=monze
DB_PASSWORD=monze
DB_NAME=monze_ride

# Live GPS tracking (Phase 2) — see src/realtime/
REDIS_HOST=localhost
REDIS_PORT=6379

# Mobile money (Phase 2) — no real MTN/Airtel sandbox is wired up yet, see
# src/payments/mobile-money.service.ts. Dev mode auto-resolves a pending
# request-to-pay as successful instead of waiting for a provider webhook.
MOBILE_MONEY_DEV_AUTO_COMPLETE=true
MOBILE_MONEY_DEV_AUTO_COMPLETE_DELAY_MS=3000
MOBILE_MONEY_WEBHOOK_SECRET=dev-webhook-secret

# SMS gateway for OTP delivery — see src/auth/sms.service.ts. Leave unset in
# dev/CI: OTPs are logged instead of sent, and no network calls are made.
# Set both to switch on real delivery via Africa's Talking.
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=
# AFRICASTALKING_API_URL=https://api.africastalking.com/version1/messaging

# Deployment — see backend/README.md's "Deployment" section. Leave unset
# (defaults to true) for local dev; the Docker image sets this to false and
# runs migrations as its own deploy step instead.
# MIGRATIONS_RUN=false

# Automatic driver payouts (Phase 4) — see backend/README.md's "Driver
# payout automation" section. Off by default: leave AUTO_PAYOUT_ENABLED
# unset and nothing changes (drivers can still cash out on demand via
# POST /payments/payout; an admin can still trigger a sweep manually via
# POST /payments/auto-payouts/run).
# AUTO_PAYOUT_ENABLED=false
# AUTO_PAYOUT_CRON=0 2 * * *
# AUTO_PAYOUT_MIN_BALANCE=50
