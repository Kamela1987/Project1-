# Copy to .env and fill in.  .env is gitignored - never commit real credentials.

# Gmail SMTP. SMTP_PASSWORD must be an App Password, NOT your normal Google password:
#   https://myaccount.google.com/apppasswords   (needs 2-Step Verification enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=

# Where the tech news digest goes
NEWS_EMAIL_TO=you@example.com

# Optional: defaults to SMTP_USER
# EMAIL_FROM=your.address@gmail.com

# Paper-trading bot (Binance SPOT TESTNET only - fake funds, never production).
# Get free keys at https://testnet.binance.vision/ - do NOT put real Binance
# API keys here.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional bot defaults - all can also be passed as CLI flags, see
# paper_trading_bot/README.md
# BOT_SYMBOL=BTCUSDT
# BOT_INTERVAL=1m
# BOT_SHORT_WINDOW=5
# BOT_LONG_WINDOW=20
# BOT_TRADE_QUOTE_QTY=50
# BOT_LOOP_INTERVAL_SECONDS=60
# BOT_DRY_RUN=false
